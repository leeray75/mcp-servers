# Copy to .env and fill in. .env is git-ignored and excluded from the Docker build context.
# Never commit real values. Placeholders starting with "replace-me" are rejected at startup.

# OAuth "Desktop app" client from Google Cloud Console (see README).
GOOGLE_CLIENT_ID=replace-me-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me-client-secret

# Shared secret that MCP clients (Goose) must send as "Authorization: Bearer <value>".
# Minimum 32 characters. Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-at-least-32-random-characters

# --- Optional (defaults shown) ---------------------------------------------
# Host port published on 127.0.0.1 only. The server also reads it to build the sign-in link
# (http://127.0.0.1:<HOST_PORT>/auth) and the OAuth redirect URI.
# HOST_PORT=8765
# Space-separated; must be a subset of: gmail.readonly gmail.compose
# GMAIL_SCOPES=gmail.readonly gmail.compose
# LOG_LEVEL=INFO
# MAX_RESULTS_CAP=50
# MAX_BODY_CHARS=20000
# Ask an MCP client that supports URL-mode elicitation to open the sign-in page when the token
# needs renewing. Set to false to always use the plain AUTH_REQUIRED tool error instead.
# AUTH_URL_ELICITATION=true
