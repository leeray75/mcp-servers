# Copy to .env and fill in (or run scripts/setup.sh). .env is git-ignored and excluded from
# the Docker build context. Never commit real values.
# Placeholders starting with "replace-me" are rejected at startup.

# --- MCP access (OPTIONAL) ---
# Default: NO token, so /mcp needs no authentication (the port is published on 127.0.0.1 only;
# the server logs a startup warning). To require "Authorization: Bearer <value>" from clients,
# set a token of at least 32 characters (generate: openssl rand -hex 32), or run
# scripts/setup.sh --force --with-token. Placeholders starting "replace-me" are rejected.
# MCP_AUTH_TOKEN=

# --- Optional (defaults shown) ---------------------------------------------
# Host port published on 127.0.0.1 only.
# HOST_PORT=8768
# LOG_LEVEL=info

# Self-hosted Firecrawl API (resolved on the firecrawl_backend network).
# FIRECRAWL_API_URL=http://api:3002
# Only if your Firecrawl API enforces auth (self-hosted without auth needs none).
# FIRECRAWL_API_KEY=

# API request filter: strips cloud-only search fields (domainTools, toolDetail) that the self-hosted
# Firecrawl API rejects with 400. Loopback inside the container only; never published.
# API_FILTER_ENABLED=true
# API_FILTER_PORT=3001

# Gateway tuning
# MAX_REQUEST_BYTES=1048576
# CHILD_START_TIMEOUT_SECONDS=30
