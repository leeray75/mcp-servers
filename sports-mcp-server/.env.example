# Copy to .env and fill in (or run scripts/setup.sh). .env is git-ignored and excluded from
# the Docker build context. Never commit real values.
# Placeholders starting with "replace-me" are rejected at startup.

# --- MCP access ---
# Shared secret that MCP clients (Goose) must send as "Authorization: Bearer <value>".
# Minimum 32 characters. Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-at-least-32-random-characters

# --- Optional (defaults shown) ---------------------------------------------
# Host port published on 127.0.0.1 only.
# HOST_PORT=8767
# LOG_LEVEL=INFO

# Upstream (ESPN's unofficial public API; no key needed). Requests only ever go to this host.
# ESPN_BASE_URL=https://site.api.espn.com
# ESPN_TIMEOUT_SECONDS=10
# ESPN_MAX_CONCURRENCY=4
# ESPN_MAX_RESPONSE_BYTES=12582912

# Time zone used to resolve "today" / "yesterday" / "tomorrow" (IANA name).
# DEFAULT_TIMEZONE=America/New_York

# Cap on the text a tool returns (characters).
# MAX_RESPONSE_CHARS=20000

# Cache TTLs in seconds, and how long an expired copy may be served if ESPN is failing.
# TTL_LIVE_SECONDS=15
# TTL_SCOREBOARD_IDLE_SECONDS=120
# TTL_SUMMARY_PRE_SECONDS=120
# TTL_SUMMARY_POST_SECONDS=3600
# TTL_STANDINGS_SECONDS=600
# TTL_TEAMS_SECONDS=86400
# TTL_SCHEDULE_SECONDS=300
# TTL_SCHEDULE_LIVE_SECONDS=60
# TTL_NEWS_SECONDS=300
# Player lookups: search results (1 h) and player stats / game logs (5 min).
# TTL_PLAYER_SEARCH_SECONDS=3600
# TTL_PLAYER_SECONDS=300
# Most recent seasons fetched by get_player_gamelog(season="all") (1-25).
# PLAYER_MAX_SEASONS=10
# STALE_IF_ERROR_SECONDS=300
# CACHE_MAX_ENTRIES=256
# Approximate resident MiB of cached payloads (container limit is 512 MiB).
# CACHE_MAX_MB=96
