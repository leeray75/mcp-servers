# Copy to .env and fill in (or run scripts/setup.sh). .env is git-ignored and excluded from
# the Docker build context. Never commit real values.
# Placeholders starting with "replace-me" are rejected at startup.

# --- Vision backend (any OpenAI-compatible /chat/completions endpoint, e.g. LiteLLM) ---
VISION_API_KEY=replace-me-with-the-litellm-key
# VISION_BASE_URL=http://spark-8013.taileaa4a8.ts.net:4000/v1
# VISION_MODEL=qwen3.8-27b

# --- MCP access ---
# Shared secret that MCP clients (Goose) must send as "Authorization: Bearer <value>".
# Minimum 32 characters. Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-at-least-32-random-characters

# --- Images the server may read ---
# The ONLY folder mounted into the container (read-only). Use the WSL spelling, and keep
# it as narrow as you can: anything image-like below it can be sent to the vision model.
HOST_IMAGES_DIR=/mnt/c/Users/YOU/Pictures
# The same folder as Windows spells it, so agents can pass the paths they see.
WINDOWS_IMAGES_DIR=C:\Users\YOU\Pictures

# --- Optional (defaults shown) ---------------------------------------------
# Host port published on 127.0.0.1 only.
# HOST_PORT=8766
# LOG_LEVEL=INFO
# VISION_TIMEOUT_SECONDS=180
# VISION_MAX_TOKENS=3000
# VISION_TEMPERATURE=0.2
# MAX_IMAGES_PER_CALL=4
# MAX_IMAGE_BYTES=20971520
# MAX_IMAGE_SIDE=2048
# MAX_ANSWER_CHARS=20000
