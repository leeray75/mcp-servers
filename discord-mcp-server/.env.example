# Copy to .env and fill in (or run scripts/setup.sh). .env is git-ignored and excluded from the
# Docker build context. Never commit real values. Placeholders starting with "replace-me" are
# rejected at startup. Config errors name the field and never print the value.

# --- Required -----------------------------------------------------------------------------
# Bearer token that MCP clients must send as "Authorization: Bearer <value>". Minimum 32 chars.
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-at-least-32-random-characters

# Discord bot token (Developer Portal > your app > Bot > Reset Token). Secret: never commit it.
DISCORD_BOT_TOKEN=replace-me-discord-bot-token

# Guild (server) allowlist: comma-separated snowflake ids, 1-100 entries. Default-deny: a guild
# not listed here is never read, and an empty or missing value stops the server from starting.
DISCORD_ALLOWED_GUILD_IDS=replace-me-guild-id

# --- Container (compose only) ----------------------------------------------------------------
# Host port published on 127.0.0.1 only.
# HOST_PORT=8769

# --- Discord ----------------------------------------------------------------------------------
# Optional. If set and different from the application the token belongs to, a WARNING is logged.
# DISCORD_APPLICATION_ID=
# Discord REST API base. Must be https://discord.com/api/v<N> with N >= 10.
# DISCORD_API_BASE=https://discord.com/api/v10
# Must look like: DiscordBot (<url>, <version>)
# DISCORD_USER_AGENT=DiscordBot (https://github.com/leeray75/mcp-servers, 0.1.0)
# Intent overrides: these can only DISABLE a tool. Privileged intents are detected at boot.
# DISCORD_ENABLE_SEARCH=true
# DISCORD_ENABLE_MEMBER_LIST=true
# Force-enable escape hatches (A1-R6): register the tool even when the application flags do not show
# the intent (for example when flags are missing, or detection disagrees with the portal). Default false.
# These never override DISCORD_ENABLE_SEARCH=false or DISCORD_ENABLE_MEMBER_LIST=false.
# DISCORD_FORCE_MESSAGE_CONTENT=false
# DISCORD_FORCE_GUILD_MEMBERS=false
# Per-request timeout in seconds (1-60).
# DISCORD_TIMEOUT_SECONDS=10
# Cap on one upstream response body in bytes (64 KiB - 16 MiB).
# Default 4 MiB (A1-R16). A page over the cap is refused with a hint to retry with a smaller limit;
# results are never truncated.
# DISCORD_MAX_RESPONSE_BYTES=4194304
# Longest in-call wait for a rate-limit bucket or global pause (0-120 s). Longer waits fail fast.
# DISCORD_MAX_RATE_LIMIT_WAIT_SECONDS=30
# Replays of a user- or global-scoped 429 within one call (0-10).
# DISCORD_MAX_429_RETRIES=3
# Extra attempts when a search index is still building (0-5).
# DISCORD_SEARCH_INDEX_RETRIES=2
# Process-wide request pacing (1-50 requests per second; Discord's limit is 50).
# DISCORD_GLOBAL_REQUESTS_PER_SECOND=40
# Invalid responses (401, 403, non-shared 429) per 10 minutes before the circuit opens (10-9000).
# DISCORD_INVALID_REQUEST_BUDGET=1000

# --- Cache and budget -----------------------------------------------------------------------
# TTL for slow-changing metadata only (guild, roles, channels, bot member). 0 disables caching.
# TTL_METADATA_SECONDS=300
# CACHE_MAX_ENTRIES=2000
# Approximate resident MiB of cached payloads (container limit is 512 MiB).
# CACHE_MAX_MB=64
# Tool-call budget: overall per minute, and per tool per minute. Excess calls are refused, not queued.
# TOOL_CALLS_PER_MINUTE=60
# TOOL_CALLS_PER_MINUTE_PER_TOOL=30

# --- Logging ----------------------------------------------------------------------------------
# LOG_LEVEL=INFO
