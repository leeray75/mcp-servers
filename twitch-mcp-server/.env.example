# Copy to .env and fill in (or run scripts/setup.sh). .env is git-ignored and excluded from the
# Docker build context. Never commit real values. Placeholders starting with "replace-me" are
# rejected at startup. Config errors name the field and never print the value.
#
# Register the Twitch application at https://dev.twitch.tv/console/apps and add this exact OAuth
# Redirect URL (only needed when TWITCH_USER_OAUTH=true):
#   https://127.0.0.1:<HOST_PORT>/oauth/callback     (default https://127.0.0.1:8770/oauth/callback)
# Twitch's console rejects a plain-http Redirect URL, so the server must serve TLS: run
# scripts/make-cert.ps1 (or make-cert.sh) and set the two TWITCH_TLS_* variables below. The scheme
# of the URI the server sends is derived from those two variables, so what you register and what the
# server sends cannot disagree.

# --- Required -----------------------------------------------------------------------------
# Bearer token that MCP clients must send as "Authorization: Bearer <value>". Minimum 32 chars.
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-at-least-32-random-characters

# Twitch application Client ID (Developer Console > your app). Not a secret, but keep it in .env.
TWITCH_CLIENT_ID=replace-me-twitch-client-id

# Twitch application Client Secret (Developer Console > your app > New Secret). Secret: never commit it.
# Used to mint the app token (client_credentials) and to exchange the user OAuth code.
TWITCH_CLIENT_SECRET=replace-me-twitch-client-secret

# Broadcaster allowlist: comma-separated Twitch user ids, 1-20 digits each, 1-100 entries.
# Default-deny: a broadcaster not listed here is never read, and an empty or missing value stops
# the server from starting. Get a user id at https://twitchtools.dev/id-lookup or with get_users.
TWITCH_ALLOWED_BROADCASTER_IDS=replace-me-broadcaster-user-id

# --- Container (compose only) ----------------------------------------------------------------
# Host port published on 127.0.0.1 only.
# HOST_PORT=8770

# --- Twitch ----------------------------------------------------------------------------------
# Twitch Helix API base. Must be exactly https://api.twitch.tv/helix (any other value is a
# startup failure - R9).
# TWITCH_API_BASE=https://api.twitch.tv/helix
# Twitch OAuth/identity base. Must be exactly https://id.twitch.tv (R9).
# TWITCH_AUTH_BASE=https://id.twitch.tv
# Per-request timeout in seconds (1-60).
# TWITCH_TIMEOUT_SECONDS=10
# Cap on one upstream response body in bytes (64 KiB - 16 MiB). Default 4 MiB. A page over the cap
# is refused with a hint to lower `first`; results are never truncated (R14/R41).
# TWITCH_MAX_RESPONSE_BYTES=4194304
# Longest in-call wait for a rate-limit bucket to clear (0-120 s). Longer waits fail fast with
# kind=rate_limited and retry_after, and the request is not made (R21).
# TWITCH_MAX_RATE_LIMIT_WAIT_SECONDS=30
# Replays of a 429 within one call, READS only (0-10). Writes are never retried, under any
# condition, regardless of this value (R16).
# TWITCH_MAX_429_RETRIES=3
# Extra attempts for a read on 5xx or a transport error (0-10). A 503 is retried once (R15).
# TWITCH_MAX_5XX_RETRIES=2

# --- HTTPS for the OAuth redirect (optional; off by default - docs/specs/tls-oauth-redirect) -------
# Twitch's developer console rejects a plain-http Redirect URL, so user OAuth needs the server to
# serve TLS. Set BOTH variables or neither - one alone stops the server from starting. They are
# container-side paths inside the read-only /certs mount that docker-compose.tls.yml adds when both
# are set; the host-side folder is ./certs (git-ignored, holds a private key - never commit it).
# Generate the material (a local CA plus a localhost/127.0.0.1 leaf) with:
#   powershell -File scripts\make-cert.ps1   (Windows; also trusts the CA for the current user)
#   scripts/make-cert.sh                     (WSL/Linux)
# Then uncomment both lines below and restart with scripts/start.sh. With TLS on, plain http on the
# same port fails at the TLS handshake and is never redirected. The server does not check the key's
# permissions: keep the key owner-only (chmod 600) on the host. The redirect URI the server sends
# becomes https://127.0.0.1:<HOST_PORT>/oauth/callback.
# TWITCH_TLS_CERT_FILE=/certs/server.crt
# TWITCH_TLS_KEY_FILE=/certs/server.key

# --- User identity (optional; off by default - R46) -------------------------------------------
# Off by default: the server then has no /oauth/* routes, no token file, no account tools, and
# reads use the app token only. Turn it on to give the server your own broadcaster identity
# (stream markers, subscribers, editors, moderators, bans, automod settings, chatters).
# TWITCH_USER_OAUTH=false
# Space-delimited scope list sent to https://id.twitch.tv/oauth2/authorize. Request ONLY the
# scopes the tools you actually use need - see the per-group table in README section "Per-group
# OAuth scopes" (spec 6.6). There is no scope table in the code (D10): when a scope is missing,
# Twitch's own 401/403 body names it and the tool returns kind=permission with that name in the
# hint. Example for a channel operator who also runs polls:
#   channel:read:subscriptions channel:manage:broadcast channel:manage:polls
# TWITCH_OAUTH_SCOPES=
# Where the user token is stored in the container. The compose override mounts the named volume
# twitch-mcp-data there (docker-compose.oauth.yml). Must be an absolute path. The file is written 0600 (R48).
# TWITCH_OAUTH_TOKEN_FILE=/data/twitch_user_token.json

# --- Writes (two independent kill switches - R28) ---------------------------------------------
# SECURITY-RELEVANT. Both must be thrown before any write tool is registered. With the defaults
# below the server exposes read tools only, and any write tool name returns "unknown tool".
#
# Switch 1 of 2: the global write switch. Off by default.
# TWITCH_ENABLE_WRITES=false
# Switch 2 of 2: which write groups exist at all. Empty by default (no group is enabled even when
# TWITCH_ENABLE_WRITES=true). Comma-separated subset of:
#   channel,polls,predictions,chat,moderation,roles
# Each group also needs its OAuth scopes on the user token (README), the operator to be the
# broadcaster itself or a verified editor/moderator there (R29), and a single-use confirm token
# per call (R31-R34). Writes are never retried (R16).
# TWITCH_WRITE_GROUPS=
# How long a minted confirmation token stays valid, in seconds (30-3600). Tokens are single-use,
# in-memory, never logged and never written to disk (R32/R33).
# TWITCH_CONFIRM_TOKEN_TTL_SECONDS=300
# How long a verified moderator/editor status may be cached, in seconds (0-3600). Invalidated on
# token refresh, disconnect and the first 401 (R30).
# TWITCH_IDENTITY_TTL_SECONDS=300
# Individual tool kill switches (R36): set TWITCH_DISABLE_<TOOL>=true to omit one tool by name,
# e.g. TWITCH_DISABLE_SEND_CHAT_MESSAGE=true. The name is upper-snake of the tool name.

# --- Cache ---------------------------------------------------------------------------------------
# TTL for slow-changing metadata and identity verification only. 0 disables caching.
# TTL_METADATA_SECONDS=300
# CACHE_MAX_ENTRIES=2000
# Approximate resident MiB of cached payloads (container limit is 512 MiB).
# CACHE_MAX_MB=64

# --- Logging ----------------------------------------------------------------------------------
# LOG_LEVEL=INFO
